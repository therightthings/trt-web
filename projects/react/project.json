{
  "name": "react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/react/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project react --web",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "format": ["esm"],
        "outputPath": "dist/react",
        "main": "projects/react/src/public-api.ts",
        "tsConfig": "projects/react/tsconfig.lib.json",
        "assets": ["projects/react/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "projects/react/vitest.config.mts"
      }
    }
  }
}
