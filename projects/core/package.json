{
  "name": "@trt-web/core",
  "version": "1.6.0",
  "type": "module",
  "main": "./src/public-api.js",
  "module": "./src/public-api.js",
  "types": "./src/public-api.d.ts",
  "sideEffects": false,
  "bin": {
    "trt-core": "./src/cli.js"
