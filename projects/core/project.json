{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/core/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "format": ["esm"],
        "outputPath": "dist/core",
        "main": "projects/core/src/public-api.ts",
        "tsConfig": "projects/core/tsconfig.lib.json",
        "assets": ["projects/core/*.md"]
      }
    },
    "cli": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "format": ["esm"],
        "outputPath": "dist/core-cli",
        "main": "projects/core/src/cli.ts",
        "tsConfig": "projects/core/tsconfig.cli.json",
        "assets": ["projects/core/README.md", "projects/core/package.json"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "projects/core/vitest.config.mts"
      }
    }
  }
}
