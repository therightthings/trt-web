{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/angular",
  "allowedNonPeerDependencies": ["@angular/aria", "@trt-web/core"],
  "assets": [
    {
      "glob": "aria-base-styles.css",
