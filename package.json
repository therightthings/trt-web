{
  "name": "mono-repo",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node --experimental-strip-types scripts/cli.ts build",
    "lint": "node --experimental-strip-types scripts/cli.ts lint",
    "release": "node --experimental-strip-types scripts/cli.ts release",
    "test": "node --experimental-strip-types scripts/cli.ts test",
    "build:all": "nx reset && nx run-many -t build",
    "reset": "nx reset",
    "commitlint": "commitlint",
    "lint:check": "eslint",
    "lint:fix": "eslint --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "npx husky",
    "typecheck": "node --experimental-strip-types scripts/cli.ts typecheck",
    "check:deadcode": "node --experimental-strip-types scripts/cli.ts check:deadcode",
    "check:circular": "node --experimental-strip-types scripts/cli.ts check:circular",
    "check:spell": "node --experimental-strip-types scripts/cli.ts check:spell",
    "check:package": "node --experimental-strip-types scripts/cli.ts check:package"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,html}": [
      "npx eslint --fix"
    ],
    "projects/vue/**/*.vue": [
      "npx eslint --fix --config projects/vue/eslint.config.mjs"
    ],
    "*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,html,scss,less,css,json,md,vue}": [
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "~22.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "~7.8.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.5",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-angular": "^20.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nx/angular": "^23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "^23.0.1",
    "@nx/node": "^23.0.1",
    "@nx/react": "^23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/vue": "^23.0.1",
    "@schematics/angular": "~21.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "~4.1.0",
    "@vue/test-utils": "^2.4.6",
    "angular-eslint": "^21.2.0",
    "commander": "^15.0.0",
    "cspell": "^10.0.1",
    "enquirer": "^2.4.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "^6.24.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "ng-packagr": "^22.0.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8"
  }
}
