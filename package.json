{
  "name": "trt-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "npx husky",
    "build": "node --experimental-strip-types scripts/cli.ts build",
    "lint": "node --experimental-strip-types scripts/cli.ts lint",
    "serve": "node --experimental-strip-types scripts/cli.ts serve",
    "release:angular": "yarn build angular && cd dist/angular && yarn publish --access public",
    "release:core": "yarn build core && cd dist/core && yarn publish --access public",
    "release:firebase-admin": "yarn build firebase-admin && cd dist/firebase-admin && yarn publish --access public",
    "release:react": "yarn build react && cd dist/react && yarn publish --access public",
    "release:vue": "yarn build vue && cd dist/vue && yarn publish --access public",
    "test": "node --experimental-strip-types scripts/cli.ts test",
    "build:all": "nx reset && nx run-many -t build",
    "reset": "nx reset",
    "commitlint": "commitlint",
    "lint:check": "eslint",
    "lint:fix": "eslint --fix",
    "sort:imports": "eslint --fix --fix-type layout",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node --experimental-strip-types scripts/cli.ts typecheck",
    "check:deadcode": "node --experimental-strip-types scripts/cli.ts check:deadcode",
    "check:circular": "node --experimental-strip-types scripts/cli.ts check:circular",
    "check:spell": "node --experimental-strip-types scripts/cli.ts check:spell",
    "check:package": "node --experimental-strip-types scripts/cli.ts check:package"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,html}": [
      "npx eslint --fix --no-warn-ignored"
    ],
    "*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,html,scss,less,css,json,md,vue}": [
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "~22.0.0",
    "busboy": "^1.6.0",
    "firebase-admin": "^14.1.0",
    "node-cache": "^5.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "rxjs": "~7.8.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.5",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-angular": "^20.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nx/angular": "^23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "^23.0.1",
    "@nx/node": "^23.0.1",
    "@nx/playwright": "23.0.1",
    "@nx/react": "^23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/vue": "^23.0.1",
    "@nx/web": "23.0.1",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~21.2.0",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "angular-eslint": "^21.2.0",
    "commander": "^15.0.0",
    "cspell": "^10.0.1",
    "enquirer": "^2.4.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "^6.24.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "ng-packagr": "^22.0.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "sass": "^1.97.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8"
  }
}
